# ──────────────────────────────────────────────────────────────
# .NET build output
# ──────────────────────────────────────────────────────────────
bin/
obj/
*.dll
*.exe
*.pdb
*.cache
*.suo
*.binlog
project.lock.json
project.fragment.lock.json
artifacts/
publish/
out/
PublishProfiles/
*.publishproj
*.pubxml
*.pubxml.user

# ──────────────────────────────────────────────────────────────
# IDE / Editor metadata
# ──────────────────────────────────────────────────────────────
.vs/
.vscode/
.idea/
*.user
*.userosscache
*.userprefs
*.sln.docstates
*.swp
*.swo
*~
*.DotSettings.user

# Rider
.idea/
*.sln.iml

# JetBrains ReSharper
_ReSharper*/
*.[Rr]e[Ss]harper

# ──────────────────────────────────────────────────────────────
# Runtime artifacts created by the app
# (FileStorageService.EnsureDirectoriesExist() recreates these
#  at startup, so they do not need to be tracked.)
# ──────────────────────────────────────────────────────────────
Output/
Temp/

# Per-test scratch
TestResults/
coverage*.xml
coverage*.json
*.coverage

# ──────────────────────────────────────────────────────────────
# Local secret overrides — never commit a real license key
# ──────────────────────────────────────────────────────────────
appsettings.Local.json
appsettings.*.Local.json
secrets.json
*.pfx
*.p12
*.key
*.pem
.env
.env.*

# ──────────────────────────────────────────────────────────────
# Logs
# ──────────────────────────────────────────────────────────────
logs/
*.log

# ──────────────────────────────────────────────────────────────
# OS noise
# ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
Desktop.ini
$RECYCLE.BIN/

# ──────────────────────────────────────────────────────────────
# NuGet
# ──────────────────────────────────────────────────────────────
*.nupkg
*.snupkg
packages/
.nuget/packages/

# ──────────────────────────────────────────────────────────────
# Node (in case anyone adds tooling later)
# ──────────────────────────────────────────────────────────────
node_modules/
npm-debug.log
yarn-error.log
