@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <i class="bi bi-exclamation-triangle-fill text-danger" style="font-size:4rem;"></i>
    <h1 class="mt-3">Something went wrong</h1>
    <p class="text-muted">An unexpected error occurred while processing your request.</p>

    @if (Model.ShowRequestId)
    {
        <div class="alert alert-secondary d-inline-block mt-3 text-start">
            <strong>Request ID:</strong> <code>@Model.RequestId</code>
        </div>
    }

    <div class="mt-4">
        <a href="/" class="btn btn-primary me-2"><i class="bi bi-house me-1"></i>Return Home</a>
        <button class="btn btn-outline-secondary" onclick="history.back()"><i class="bi bi-arrow-left me-1"></i>Go Back</button>
    </div>
</div>
