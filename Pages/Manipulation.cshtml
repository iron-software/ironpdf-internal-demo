@page
@model ManipulationModel
@{
    ViewData["Title"] = "Manipulate PDFs";
    ViewData["ActivePage"] = "Manipulation";
}

<ul class="nav nav-tabs mb-4">
    <li class="nav-item"><a class="nav-link active" href="#merge" data-bs-toggle="tab">Merge</a></li>
    <li class="nav-item"><a class="nav-link" href="#split" data-bs-toggle="tab">Split</a></li>
    <li class="nav-item"><a class="nav-link" href="#rotate" data-bs-toggle="tab">Rotate</a></li>
    <li class="nav-item"><a class="nav-link" href="#compress" data-bs-toggle="tab">Compress</a></li>
    <li class="nav-item"><a class="nav-link" href="#redact" data-bs-toggle="tab">Redact</a></li>
    <li class="nav-item"><a class="nav-link" href="#pageinfo" data-bs-toggle="tab">Page Info</a></li>
</ul>

<div class="tab-content">
    <div class="tab-pane fade show active" id="merge">
        <div class="card border-0 shadow-sm"><div class="card-body">
            <h5 class="section-header">Merge PDFs</h5>
            <form id="mergeForm" enctype="multipart/form-data">
                <div class="upload-zone mb-3" id="mergeZone">
                    <i class="bi bi-files"></i>
                    <p>Select 2 or more PDF files to merge</p>
                    <input type="file" name="Files" id="mergeInput" accept=".pdf" multiple class="d-none"/>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="AddPageNumbers" value="true" id="pageNums"/>
                    <label class="form-check-label" for="pageNums">Add page numbers to merged PDF</label>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-collection me-1"></i>Merge PDFs</button>
            </form>
            <div id="mergeResult" style="display:none;"></div>
        </div></div>
    </div>

    <div class="tab-pane fade" id="split">
        <div class="card border-0 shadow-sm"><div class="card-body">
            <h5 class="section-header">Split PDF</h5>
            <form id="splitForm" enctype="multipart/form-data">
                <div class="upload-zone mb-3" id="splitZone">
                    <i class="bi bi-file-pdf"></i>
                    <p>Select a PDF to split</p>
                    <input type="file" name="File" id="splitInput" accept=".pdf" class="d-none"/>
                </div>
                <div class="mb-3">
                    <label class="form-label">Split at page number</label>
                    <input type="number" name="SplitAtPage" class="form-control w-auto" value="1" min="1"/>
                    <div class="form-text">Pages 1 to N go to Part 1; N+1 onwards go to Part 2.</div>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-scissors me-1"></i>Split PDF</button>
            </form>
            <div id="splitResult" style="display:none;"></div>
        </div></div>
    </div>

    <div class="tab-pane fade" id="rotate">
        <div class="card border-0 shadow-sm"><div class="card-body">
            <h5 class="section-header">Rotate Pages</h5>
            <form id="rotateForm" enctype="multipart/form-data">
                <div class="upload-zone mb-3" id="rotateZone">
                    <i class="bi bi-file-pdf"></i><p>Select a PDF</p>
                    <input type="file" name="File" id="rotateInput" accept=".pdf" class="d-none"/>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-3">
                        <label class="form-label">Rotation</label>
                        <select name="RotateDeg" class="form-select">
                            <option value="90">90° Clockwise</option>
                            <option value="180">180°</option>
                            <option value="270">270° Clockwise</option>
                        </select>
                    </div>
                    <div class="col-md-5">
                        <label class="form-label">Pages (comma-separated, blank = all)</label>
                        <input type="text" name="pages" class="form-control" placeholder="1,2,3 or blank for all"/>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-arrow-clockwise me-1"></i>Rotate</button>
            </form>
            <div id="rotateResult" style="display:none;"></div>
        </div></div>
    </div>

    <div class="tab-pane fade" id="compress">
        <div class="card border-0 shadow-sm"><div class="card-body">
            <h5 class="section-header">Compress PDF</h5>
            <form id="compressForm" enctype="multipart/form-data">
                <div class="upload-zone mb-3" id="compressZone">
                    <i class="bi bi-file-zip"></i><p>Select a PDF to compress</p>
                    <input type="file" name="File" id="compressInput" accept=".pdf" class="d-none"/>
                </div>
                <div class="mb-3">
                    <label class="form-label">Image Quality: <span id="qualityVal">80</span>%</label>
                    <input type="range" name="ImageQuality" class="form-range" min="10" max="100" value="80" oninput="document.getElementById('qualityVal').textContent=this.value"/>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-file-zip me-1"></i>Compress</button>
            </form>
            <div id="compressResult" style="display:none;"></div>
        </div></div>
    </div>

    <div class="tab-pane fade" id="redact">
        <div class="card border-0 shadow-sm"><div class="card-body">
            <h5 class="section-header">Redact Text</h5>
            <form id="redactForm" enctype="multipart/form-data">
                <div class="upload-zone mb-3" id="redactZone">
                    <i class="bi bi-file-pdf"></i><p>Select a PDF</p>
                    <input type="file" name="File" id="redactInput" accept=".pdf" class="d-none"/>
                </div>
                <div class="mb-3">
                    <label class="form-label">Text to Redact (one per line)</label>
                    <textarea name="textToRedact" class="form-control" rows="4" placeholder="Enter text patterns to redact...">Confidential
SECRET</textarea>
                </div>
                <div class="form-check mb-3">
                    <input class="form-check-input" type="checkbox" name="CaseSensitive" value="true"/>
                    <label class="form-check-label">Case sensitive matching</label>
                </div>
                <button type="submit" class="btn btn-danger"><i class="bi bi-eraser me-1"></i>Redact</button>
            </form>
            <div id="redactResult" style="display:none;"></div>
        </div></div>
    </div>

    <div class="tab-pane fade" id="pageinfo">
        <div class="card border-0 shadow-sm"><div class="card-body">
            <h5 class="section-header">Page Information</h5>
            <form id="pageinfoForm" enctype="multipart/form-data">
                <div class="upload-zone mb-3" id="pageinfoZone">
                    <i class="bi bi-file-pdf"></i><p>Select a PDF to inspect</p>
                    <input type="file" name="file" id="pageinfoInput" accept=".pdf" class="d-none"/>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-info-circle me-1"></i>Get Page Info</button>
            </form>
            <div id="pageinfoResult" class="mt-3" style="display:none;"></div>
        </div></div>
    </div>
</div>

@section Scripts {
<script>
['mergeZone mergeInput .pdf','splitZone splitInput .pdf','rotateZone rotateInput .pdf','compressZone compressInput .pdf','redactZone redactInput .pdf','pageinfoZone pageinfoInput .pdf'].forEach(s => {
    const [z,i,a] = s.split(' ');
    initDragDrop(z, i, a);
});

async function postForm(formId, endpoint, resultId, btnLabel) {
    const form = document.getElementById(formId);
    if (!form) return;
    form.addEventListener('submit', async e => {
        e.preventDefault();
        const btn = e.target.querySelector('[type=submit]');
        const orig = btn.innerHTML;
        btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Processing...';
        try {
            const res = await fetch(endpoint, { method: 'POST', body: new FormData(e.target) });
            const data = await res.json();
            if (res.ok) {
                if (Array.isArray(data)) {
                    const c = document.getElementById(resultId);
                    c.innerHTML = data.map(d => `<div class="result-card mb-2"><div class="d-flex justify-content-between align-items-center"><div><div class="filename"><i class="bi bi-file-pdf-fill me-1" style="color:#DC2626;"></i>${d.fileName}</div><div class="meta">${formatBytes(d.fileSizeBytes)} · ${d.pageCount} pages</div></div><a href="${d.downloadUrl}" class="btn btn-success btn-sm" download>Download</a></div></div>`).join('');
                    c.style.display = 'block';
                    showToast('Done!', 'success');
                } else renderResult(data, resultId);
            } else showToast(data.error || 'Failed', 'error');
        } catch(er) { showToast('Error: '+er.message, 'error'); }
        btn.disabled = false; btn.innerHTML = orig;
    });
}

postForm('mergeForm','/api/manipulation/merge','mergeResult');
postForm('splitForm','/api/manipulation/split','splitResult');
postForm('compressForm','/api/manipulation/compress','compressResult');

document.getElementById('rotateForm')?.addEventListener('submit', async e => {
    e.preventDefault();
    const fd = new FormData(e.target);
    // Handle multi-value pages
    const btn = e.target.querySelector('[type=submit]');
    btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Rotating...';
    try {
        const res = await fetch('/api/manipulation/rotate', { method: 'POST', body: fd });
        const data = await res.json();
        if (res.ok) renderResult(data, 'rotateResult');
        else showToast(data.error || 'Failed', 'error');
    } catch(er) { showToast(er.message,'error'); }
    btn.disabled = false; btn.innerHTML = '<i class="bi bi-arrow-clockwise me-1"></i>Rotate';
});

document.getElementById('redactForm')?.addEventListener('submit', async e => {
    e.preventDefault();
    const fd = new FormData(e.target);
    const terms = fd.get('textToRedact')?.split('\n').map(s => s.trim()).filter(Boolean) || [];
    const newFd = new FormData();
    newFd.append('File', fd.get('File'));
    terms.forEach(t => newFd.append('TextToRedact', t));
    if (fd.get('CaseSensitive')) newFd.append('CaseSensitive', 'true');
    const btn = e.target.querySelector('[type=submit]');
    btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Redacting...';
    try {
        const res = await fetch('/api/manipulation/redact', { method: 'POST', body: newFd });
        const data = await res.json();
        if (res.ok) renderResult(data, 'redactResult');
        else showToast(data.error || 'Failed', 'error');
    } catch(er) { showToast(er.message,'error'); }
    btn.disabled = false; btn.innerHTML = '<i class="bi bi-eraser me-1"></i>Redact';
});

document.getElementById('pageinfoForm')?.addEventListener('submit', async e => {
    e.preventDefault();
    const btn = e.target.querySelector('[type=submit]');
    btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Inspecting...';
    try {
        const res = await fetch('/api/manipulation/page-info', { method: 'POST', body: new FormData(e.target) });
        const data = await res.json();
        const container = document.getElementById('pageinfoResult');
        if (res.ok && Array.isArray(data)) {
            container.innerHTML = `<table class="table table-sm table-bordered"><thead><tr><th>Page</th><th>Width (mm)</th><th>Height (mm)</th><th>Rotation</th></tr></thead><tbody>${data.map(p => `<tr><td>${p.pageNumber}</td><td>${p.widthMm?.toFixed(1)}</td><td>${p.heightMm?.toFixed(1)}</td><td>${p.rotationDeg}°</td></tr>`).join('')}</tbody></table>`;
            container.style.display = 'block';
            showToast(`${data.length} pages found`, 'info');
        } else showToast(data.error || 'Failed','error');
    } catch(er) { showToast(er.message,'error'); }
    btn.disabled = false; btn.innerHTML = '<i class="bi bi-info-circle me-1"></i>Get Page Info';
});
</script>
}
