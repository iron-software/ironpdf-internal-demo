@page
@model ConversionModel
@{
    ViewData["Title"] = "Convert to PDF";
    ViewData["ActivePage"] = "Conversion";
}

<ul class="nav nav-tabs mb-4" id="conversionTabs">
    <li class="nav-item"><a class="nav-link active" href="#html" data-bs-toggle="tab">HTML</a></li>
    <li class="nav-item"><a class="nav-link" href="#url" data-bs-toggle="tab">URL</a></li>
    <li class="nav-item"><a class="nav-link" href="#image" data-bs-toggle="tab">Image</a></li>
    <li class="nav-item"><a class="nav-link" href="#docx" data-bs-toggle="tab">DOCX</a></li>
    <li class="nav-item"><a class="nav-link" href="#thumbnail" data-bs-toggle="tab">Thumbnail</a></li>
</ul>

<div class="tab-content">
    <!-- HTML Tab -->
    <div class="tab-pane fade show active" id="html">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5 class="section-header">HTML to PDF</h5>
                <form id="htmlForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">HTML Content</label>
                        <textarea name="htmlContent" class="form-control font-monospace" rows="8" placeholder="<h1>Hello IronPDF!</h1><p>Your HTML here...</p>"><h1 style='color:#4F46E5;font-family:Arial;'>Hello from IronPDF!</h1>
<p>This is rendered with <strong>IronPDF 2026.5.2</strong> using Chrome rendering engine.</p>
<ul><li>Full HTML5 support</li><li>CSS3 support</li><li>JavaScript support</li></ul>
<table border='1' style='border-collapse:collapse;width:100%;'>
  <tr style='background:#4F46E5;color:#fff;'><th>Feature</th><th>Status</th></tr>
  <tr><td>HTML Conversion</td><td>✅ Working</td></tr>
  <tr><td>Headers &amp; Footers</td><td>✅ Working</td></tr>
</table></textarea>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label class="form-label">Paper Size</label>
                            <select name="paperSize" class="form-select"><option>A4</option><option>Letter</option><option>Legal</option><option>A3</option></select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Orientation</label>
                            <select name="orientation" class="form-select"><option>Portrait</option><option>Landscape</option></select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">CSS Media</label>
                            <select name="cssMediaType" class="form-select"><option>Print</option><option>Screen</option></select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Enable JS</label>
                            <select name="enableJs" class="form-select"><option value="false">No</option><option value="true">Yes</option></select>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-file-pdf me-1"></i>Generate PDF</button>
                </form>
                <div id="htmlResult" style="display:none;"></div>
            </div>
        </div>
    </div>

    <!-- URL Tab -->
    <div class="tab-pane fade" id="url">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5 class="section-header">URL to PDF</h5>
                <form id="urlForm">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">URL</label>
                        <input type="url" name="url" class="form-control" placeholder="https://example.com" value="https://ironpdf.com"/>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label class="form-label">Paper Size</label>
                            <select name="paperSize" class="form-select"><option>A4</option><option>Letter</option></select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Enable JS</label>
                            <select name="enableJs" class="form-select"><option value="true">Yes</option><option value="false">No</option></select>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">JS Wait (ms)</label>
                            <input type="number" name="jsWaitMs" class="form-control" value="500"/>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-globe me-1"></i>Convert URL</button>
                </form>
                <div id="urlResult" style="display:none;"></div>
            </div>
        </div>
    </div>

    <!-- Image Tab -->
    <div class="tab-pane fade" id="image">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5 class="section-header">Image to PDF</h5>
                <form id="imageForm" enctype="multipart/form-data">
                    <div class="upload-zone mb-3" id="imageZone">
                        <i class="bi bi-image"></i>
                        <p>Drag & drop or click to select an image (PNG, JPG, GIF, BMP)</p>
                        <input type="file" name="file" id="imageInput" accept=".png,.jpg,.jpeg,.gif,.bmp,.webp" class="d-none"/>
                    </div>
                    <select name="paperSize" class="form-select w-auto mb-3"><option>A4</option><option>Letter</option></select>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-image me-1"></i>Convert Image</button>
                </form>
                <div id="imageResult" style="display:none;"></div>
            </div>
        </div>
    </div>

    <!-- DOCX Tab -->
    <div class="tab-pane fade" id="docx">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5 class="section-header">DOCX to PDF</h5>
                <form id="docxForm" enctype="multipart/form-data">
                    <div class="upload-zone mb-3" id="docxZone">
                        <i class="bi bi-file-word"></i>
                        <p>Drag & drop or click to select a .docx file</p>
                        <input type="file" name="file" id="docxInput" accept=".docx" class="d-none"/>
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-file-word me-1"></i>Convert DOCX</button>
                </form>
                <div id="docxResult" style="display:none;"></div>
            </div>
        </div>
    </div>

    <!-- Thumbnail Tab -->
    <div class="tab-pane fade" id="thumbnail">
        <div class="card border-0 shadow-sm">
            <div class="card-body">
                <h5 class="section-header">PDF Thumbnail</h5>
                <form id="thumbForm" enctype="multipart/form-data">
                    <div class="upload-zone mb-3" id="thumbZone">
                        <i class="bi bi-file-pdf"></i>
                        <p>Upload a PDF to extract a page thumbnail</p>
                        <input type="file" name="file" id="thumbInput" accept=".pdf" class="d-none"/>
                    </div>
                    <div class="row g-3 mb-3">
                        <div class="col-md-3">
                            <label class="form-label">Page Number</label>
                            <input type="number" name="pageNumber" class="form-control" value="1" min="1"/>
                        </div>
                        <div class="col-md-3">
                            <label class="form-label">Width (px)</label>
                            <input type="number" name="widthPx" class="form-control" value="300" min="100" max="1200"/>
                        </div>
                    </div>
                    <button type="submit" class="btn btn-primary"><i class="bi bi-camera me-1"></i>Extract Thumbnail</button>
                </form>
                <div id="thumbResult" class="mt-3" style="display:none;"></div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script>
initDragDrop('imageZone','imageInput','.png,.jpg,.jpeg,.gif,.bmp,.webp');
initDragDrop('docxZone','docxInput','.docx');
initDragDrop('thumbZone','thumbInput','.pdf');

document.getElementById('htmlForm').addEventListener('submit', async e => {
    e.preventDefault();
    const fd = new FormData(e.target);
    const body = { htmlContent: fd.get('htmlContent'), paperSize: fd.get('paperSize'), orientation: fd.get('orientation'), cssMediaType: fd.get('cssMediaType'), enableJs: fd.get('enableJs') === 'true' };
    const btn = e.target.querySelector('[type=submit]');
    btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Generating...';
    try {
        const res = await fetch('/api/conversion/html-to-pdf', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) });
        const data = await res.json();
        if (res.ok) renderResult(data, 'htmlResult');
        else showToast(data.error || 'Failed', 'error');
    } catch(e) { showToast('Error: '+e.message, 'error'); }
    btn.disabled = false; btn.innerHTML = '<i class="bi bi-file-pdf me-1"></i>Generate PDF';
});

document.getElementById('urlForm').addEventListener('submit', async e => {
    e.preventDefault();
    const fd = new FormData(e.target);
    const body = { url: fd.get('url'), paperSize: fd.get('paperSize'), enableJs: fd.get('enableJs') === 'true', jsWaitMs: parseInt(fd.get('jsWaitMs')) };
    const btn = e.target.querySelector('[type=submit]');
    btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Converting...';
    try {
        const res = await fetch('/api/conversion/url-to-pdf', { method: 'POST', headers: {'Content-Type':'application/json'}, body: JSON.stringify(body) });
        const data = await res.json();
        if (res.ok) renderResult(data, 'urlResult');
        else showToast(data.error || 'Failed', 'error');
    } catch(e) { showToast('Error: '+e.message, 'error'); }
    btn.disabled = false; btn.innerHTML = '<i class="bi bi-globe me-1"></i>Convert URL';
});

['imageForm','docxForm'].forEach((fId, idx) => {
    const endpoints = ['/api/conversion/image-to-pdf', '/api/conversion/docx-to-pdf'];
    const resultIds = ['imageResult','docxResult'];
    const labels = ['<i class="bi bi-image me-1"></i>Convert Image', '<i class="bi bi-file-word me-1"></i>Convert DOCX'];
    document.getElementById(fId)?.addEventListener('submit', async e => {
        e.preventDefault();
        const btn = e.target.querySelector('[type=submit]');
        btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Converting...';
        try {
            const res = await fetch(endpoints[idx], { method: 'POST', body: new FormData(e.target) });
            const data = await res.json();
            if (res.ok) renderResult(data, resultIds[idx]);
            else showToast(data.error || 'Failed', 'error');
        } catch(er) { showToast('Error: '+er.message, 'error'); }
        btn.disabled = false; btn.innerHTML = labels[idx];
    });
});

document.getElementById('thumbForm').addEventListener('submit', async e => {
    e.preventDefault();
    const btn = e.target.querySelector('[type=submit]');
    btn.disabled = true; btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Extracting...';
    try {
        const res = await fetch('/api/conversion/thumbnail', { method: 'POST', body: new FormData(e.target) });
        const data = await res.json();
        if (res.ok && data.base64Image) {
            const container = document.getElementById('thumbResult');
            container.innerHTML = `<div class="text-center"><img src="${data.base64Image}" class="img-fluid rounded shadow" style="max-height:400px;"/><div class="text-muted mt-2" style="font-size:12px;">Page ${data.pageNumber} · ${data.widthPx}×${data.heightPx}px</div></div>`;
            container.style.display = 'block';
            showToast('Thumbnail extracted!', 'success');
        } else showToast(data.error || 'Failed', 'error');
    } catch(er) { showToast('Error: '+er.message, 'error'); }
    btn.disabled = false; btn.innerHTML = '<i class="bi bi-camera me-1"></i>Extract Thumbnail';
});
</script>
}
