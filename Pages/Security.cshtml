@page
@model SecurityModel
@{
    ViewData["Title"] = "Security & Signatures";
    ViewData["ActivePage"] = "Security";
}

<ul class="nav nav-tabs mb-4">
    <li class="nav-item"><a class="nav-link active" href="#protect" data-bs-toggle="tab">Password Protect</a></li>
    <li class="nav-item"><a class="nav-link" href="#removepass" data-bs-toggle="tab">Remove Password</a></li>
    <li class="nav-item"><a class="nav-link" href="#sign" data-bs-toggle="tab">Digital Sign</a></li>
    <li class="nav-item"><a class="nav-link" href="#verify" data-bs-toggle="tab">Verify Signature</a></li>
</ul>

<div class="tab-content">
    <!-- Password Protect -->
    <div class="tab-pane fade show active" id="protect">
        <div class="card border-0 shadow-sm"><div class="card-body">
            <h5 class="section-header">Password Protect PDF</h5>
            <form id="protectForm" enctype="multipart/form-data">
                <div class="upload-zone mb-3" id="protectZone">
                    <i class="bi bi-file-pdf"></i><p>Select a PDF</p>
                    <input type="file" name="File" id="protectInput" accept=".pdf" class="d-none"/>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">User Password</label>
                        <input type="password" name="UserPassword" class="form-control" placeholder="Required to open" autocomplete="new-password"/>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Owner Password</label>
                        <input type="password" name="OwnerPassword" class="form-control" placeholder="Required to edit" autocomplete="new-password"/>
                    </div>
                </div>
                <div class="mb-3">
                    <p class="form-label">Permissions</p>
                    <div class="row g-2">
                        <div class="col-auto"><div class="form-check">
                            <input class="form-check-input" type="checkbox" name="AllowPrinting" value="true" id="pPrint" checked/>
                            <label class="form-check-label" for="pPrint">Allow Printing</label>
                        </div></div>
                        <div class="col-auto"><div class="form-check">
                            <input class="form-check-input" type="checkbox" name="AllowCopying" value="true" id="pCopy"/>
                            <label class="form-check-label" for="pCopy">Allow Copying</label>
                        </div></div>
                        <div class="col-auto"><div class="form-check">
                            <input class="form-check-input" type="checkbox" name="AllowAnnotations" value="true" id="pAnnot"/>
                            <label class="form-check-label" for="pAnnot">Allow Annotations</label>
                        </div></div>
                        <div class="col-auto"><div class="form-check">
                            <input class="form-check-input" type="checkbox" name="AllowFormFilling" value="true" id="pForm" checked/>
                            <label class="form-check-label" for="pForm">Allow Form Filling</label>
                        </div></div>
                    </div>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-lock me-1"></i>Protect PDF</button>
            </form>
            <div id="protectResult" style="display:none;"></div>
        </div></div>
    </div>

    <!-- Remove Password -->
    <div class="tab-pane fade" id="removepass">
        <div class="card border-0 shadow-sm"><div class="card-body">
            <h5 class="section-header">Remove Password Protection</h5>
            <form id="removepassForm" enctype="multipart/form-data">
                <div class="upload-zone mb-3" id="removepassZone">
                    <i class="bi bi-file-pdf"></i><p>Select a password-protected PDF</p>
                    <input type="file" name="File" id="removepassInput" accept=".pdf" class="d-none"/>
                </div>
                <div class="mb-3">
                    <label class="form-label">Current Password (owner or user)</label>
                    <input type="password" name="Password" class="form-control w-auto" autocomplete="current-password"/>
                </div>
                <button type="submit" class="btn btn-warning"><i class="bi bi-unlock me-1"></i>Remove Password</button>
            </form>
            <div id="removepassResult" style="display:none;"></div>
        </div></div>
    </div>

    <!-- Digital Sign -->
    <div class="tab-pane fade" id="sign">
        <div class="card border-0 shadow-sm"><div class="card-body">
            <h5 class="section-header">Digitally Sign PDF</h5>
            <div class="alert alert-info py-2">
                <i class="bi bi-info-circle me-1"></i>
                Upload a <code>.pfx</code> certificate file. For testing, generate one with:<br/>
                <code class="d-block mt-1 small">openssl req -x509 -newkey rsa:2048 -keyout key.pem -out cert.pem -days 365 -nodes &amp;&amp; openssl pkcs12 -export -out cert.pfx -inkey key.pem -in cert.pem</code>
            </div>
            <form id="signForm" enctype="multipart/form-data">
                <div class="row g-3 mb-3">
                    <div class="col-md-6">
                        <label class="form-label">PDF to Sign</label>
                        <div class="upload-zone" id="signPdfZone">
                            <i class="bi bi-file-pdf"></i><p>Select a PDF</p>
                            <input type="file" name="File" id="signPdfInput" accept=".pdf" class="d-none"/>
                        </div>
                    </div>
                    <div class="col-md-6">
                        <label class="form-label">PFX Certificate</label>
                        <div class="upload-zone" id="signPfxZone">
                            <i class="bi bi-file-earmark-lock2"></i><p>Select a .pfx file</p>
                            <input type="file" name="Certificate" id="signPfxInput" accept=".pfx,.p12" class="d-none"/>
                        </div>
                    </div>
                </div>
                <div class="row g-3 mb-3">
                    <div class="col-md-4">
                        <label class="form-label">Certificate Password</label>
                        <input type="password" name="CertificatePassword" class="form-control" autocomplete="new-password"/>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Reason</label>
                        <input type="text" name="Reason" class="form-control" value="Document approval"/>
                    </div>
                    <div class="col-md-4">
                        <label class="form-label">Location</label>
                        <input type="text" name="Location" class="form-control" value="New York, USA"/>
                    </div>
                </div>
                <div class="mb-3">
                    <label class="form-label">Contact Email</label>
                    <input type="email" name="ContactInfo" class="form-control w-auto" value="signer@example.com"/>
                </div>
                <button type="submit" class="btn btn-success"><i class="bi bi-pen me-1"></i>Sign PDF</button>
            </form>
            <div id="signResult" style="display:none;"></div>
        </div></div>
    </div>

    <!-- Verify Signature -->
    <div class="tab-pane fade" id="verify">
        <div class="card border-0 shadow-sm"><div class="card-body">
            <h5 class="section-header">Verify Digital Signature</h5>
            <form id="verifyForm" enctype="multipart/form-data">
                <div class="upload-zone mb-3" id="verifyZone">
                    <i class="bi bi-file-earmark-check"></i><p>Select a signed PDF</p>
                    <input type="file" name="File" id="verifyInput" accept=".pdf" class="d-none"/>
                </div>
                <button type="submit" class="btn btn-primary"><i class="bi bi-patch-check me-1"></i>Verify Signature</button>
            </form>
            <div id="verifyResult" class="mt-3" style="display:none;"></div>
        </div></div>
    </div>
</div>

@section Scripts {
<script>
['protectZone protectInput .pdf','removepassZone removepassInput .pdf',
 'signPdfZone signPdfInput .pdf','signPfxZone signPfxInput .pfx',
 'verifyZone verifyInput .pdf'].forEach(s => {
    const [z,i,a] = s.split(' ');
    initDragDrop(z, i, a);
});

async function submitSecurityForm(formId, endpoint, resultId, btnLabel) {
    const form = document.getElementById(formId);
    if (!form) return;
    form.addEventListener('submit', async e => {
        e.preventDefault();
        const btn = e.target.querySelector('[type=submit]');
        const orig = btn.innerHTML;
        btn.disabled = true;
        btn.innerHTML = `<span class="spinner-border spinner-border-sm me-1"></span>${btnLabel}...`;
        try {
            const res = await fetch(endpoint, { method: 'POST', body: new FormData(e.target) });
            const data = await res.json();
            if (res.ok) renderResult(data, resultId);
            else showToast(data.error || 'Failed', 'error');
        } catch(er) { showToast(er.message, 'error'); }
        btn.disabled = false; btn.innerHTML = orig;
    });
}

submitSecurityForm('protectForm', '/api/security/protect', 'protectResult', 'Protecting');
submitSecurityForm('removepassForm', '/api/security/remove-password', 'removepassResult', 'Removing');
submitSecurityForm('signForm', '/api/security/sign', 'signResult', 'Signing');

document.getElementById('verifyForm')?.addEventListener('submit', async e => {
    e.preventDefault();
    const btn = e.target.querySelector('[type=submit]');
    btn.disabled = true; const orig = btn.innerHTML;
    btn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span>Verifying...';
    try {
        const res = await fetch('/api/security/verify-signature', { method: 'POST', body: new FormData(e.target) });
        const data = await res.json();
        const container = document.getElementById('verifyResult');
        if (res.ok) {
            const valid = data.isValid;
            const sigCount = data.signatureCount ?? 0;
            const details = (data.signatures ?? []).map(s =>
                `<tr><td>${s.signedBy ?? '—'}</td><td>${s.reason ?? '—'}</td><td>${s.location ?? '—'}</td>
                 <td><span class="badge ${s.isValid ? 'bg-success' : 'bg-danger'}">${s.isValid ? 'Valid' : 'Invalid'}</span></td></tr>`
            ).join('');
            container.innerHTML = `
                <div class="alert ${valid ? 'alert-success' : 'alert-danger'} d-flex align-items-center gap-2">
                    <i class="bi bi-${valid ? 'patch-check-fill' : 'x-circle-fill'} fs-5"></i>
                    <div><strong>${valid ? 'All signatures valid' : 'Signature verification failed'}</strong>
                    — ${sigCount} signature${sigCount !== 1 ? 's' : ''} found</div>
                </div>
                ${details ? `<table class="table table-sm table-bordered"><thead><tr><th>Signed By</th><th>Reason</th><th>Location</th><th>Status</th></tr></thead><tbody>${details}</tbody></table>` : ''}`;
            container.style.display = 'block';
        } else showToast(data.error || 'Failed', 'error');
    } catch(er) { showToast(er.message, 'error'); }
    btn.disabled = false; btn.innerHTML = orig;
});
</script>
}
